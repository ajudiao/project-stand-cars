    {% extends "layouts/main.twig" %}

{% block content %}

    <!-- Cabeçalho -->
        <section class="bg-gradient-to-br from-primary/10 via-background to-accent/5 px-4 pt-20 py-12">
            <div class="container mx-auto">
                <h1 class="mb-4 text-4xl font-bold lg:text-5xl">Notícias e Artigos</h1>
                <p class="text-lg text-muted-foreground">Fique por dentro das últimas novidades do mundo automóvel</p>
            </div>
        </section>

    <!-- Secção de Notícias -->
        <section class="px-4 py-12">
            <div class="container mx-auto">
                {% if noticias is not empty %}
                    <!-- Artigo em Destaque (Primeiro Artigo) -->
                    <div class="mb-12">
                        {% set featured = noticias[0] %}
                        <div class="overflow-hidden rounded-2xl border border-border bg-card transition-shadow hover:shadow-lg">
                            <div class="grid gap-8 lg:grid-cols-2">
                                <div class="aspect-[16/10] overflow-hidden lg:aspect-auto">
                                    <img src="{% if featured.imagem_capa %}/uploads/news/{{ featured.imagem_capa }}{% else %}https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=600&h=400&fit=crop{% endif %}" alt="{{ featured.titulo }}" class="h-full w-full object-cover">
                                </div>
                                <div class="flex flex-col justify-center p-8">
                                    <h2 class="mb-4 text-3xl font-bold lg:text-4xl">{{ featured.titulo }}</h2>
                                    <p class="mb-4 text-lg leading-relaxed text-muted-foreground">{{ featured.resumo | default(featured.conteudo | slice(0, 200)) }}</p>
                                    <div class="mb-6 flex items-center gap-4 text-sm text-muted-foreground">
                                        {% if featured.autor %}
                                        <span>{{ featured.autor }}</span>
                                        <span>•</span>
                                        {% endif %}
                                        <span>{{ featured.data_publicacao | date('d/m/Y') }}</span>
                                    </div>
                                    <a href="/noticias/{{ featured.slug }}" class="inline-flex w-fit items-center justify-center rounded-lg bg-primary px-6 py-3 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90">
                                        Ler Artigo Completo
                                        <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Grid de Artigos -->
                <div id="articles-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                    {% for noticia in noticias %}
                        {% if loop.index > 1 or noticias is empty %}
                    <article class="group overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-all hover:shadow-lg">
                        <div class="aspect-[16/10] overflow-hidden">
                            <img src="{% if noticia.imagem_capa %}/uploads/news/{{ noticia.imagem_capa }}{% else %}https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=400&h=250&fit=crop{% endif %}" alt="{{ noticia.titulo }}" class="h-full w-full object-cover transition-transform group-hover:scale-105">
                        </div>
                        <div class="p-6">
                            <div class="mb-2 flex items-center gap-2 text-sm text-muted-foreground">
                                <time datetime="{{ noticia.data_publicacao }}">{{ noticia.data_publicacao | date('d/m/Y') }}</time>
                                {% if noticia.autor %}
                                <span>•</span>
                                <span>{{ noticia.autor }}</span>
                                {% endif %}
                            </div>
                            <h3 class="mb-3 text-xl font-bold leading-tight">
                                <a href="/noticias/{{ noticia.slug }}" class="transition-colors hover:text-primary">{{ noticia.titulo }}</a>
                            </h3>
                            {% if noticia.resumo %}
                            <p class="text-muted-foreground">{{ noticia.resumo | slice(0, 120) }}...</p>
                            {% endif %}
                            <a href="/noticias/{{ noticia.slug }}" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary/80">
                                Ler mais
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </article>
                        {% endif %}
                    {% endfor %}
                </div>

                {% if noticias is empty %}
                    <div class="rounded-lg border border-border bg-card p-12 text-center">
                        <svg class="mx-auto mb-4 h-16 w-16 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <h3 class="mb-2 text-xl font-bold">Nenhuma notícia encontrada</h3>
                        <p class="text-muted-foreground">Volte em breve para novidades!</p>
                    </div>
                {% endif %}
            </div>
        </section>

{% endblock %}